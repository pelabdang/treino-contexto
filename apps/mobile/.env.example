# Copie para .env.local (ignorado pelo git). Os valores abaixo são os padrões.
# URL da API (FastAPI local).
EXPO_PUBLIC_API_URL=http://localhost:8000
# Atleta exibido no app (sem login). 1 é o atleta das fixtures.
EXPO_PUBLIC_ATLETA_ID=1
# Professor da caixa do dia (rota /caixa-do-dia, sem login). Sem valor, a tela mostra "Caixa do dia não encontrada".
EXPO_PUBLIC_PROFESSOR_ID=
