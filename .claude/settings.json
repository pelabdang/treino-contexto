{
    "permissions": {
        "defaultMode": "auto",
        "ask": [
            "Bash(gh pr merge:*)"
        ]
    },
    "teammateMode": "tmux",
    "hooks": {
        "TaskCompleted": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/testes.sh"
                    }
                ]
            }
        ]
    },
    "env": {
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
    }
}
