# Copie para .env e ajuste. O .env fica fora do git.
DATABASE_URL=postgresql+psycopg://treino:treino@localhost:5433/treino

# Origens do app web liberadas no CORS, separadas por vírgula. Nunca '*'. Vazio não libera nenhuma.
CORS_ORIGENS=http://localhost:8081

# Pasta dos FIT enviados por upload (fora do git). Relativo = a partir da raiz do repositório.
FIT_DIR=dados-upload/fit

# IA do produto (camada trocável, ver AGENTS.md)
LLM_PROVIDER=groq
LLM_MODEL=
# Chave do provedor escolhido (so no .env local). Provedores aceitos: groq, openai, anthropic, ou `falso` (testes, sem chave).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Tempo limite por chamada (s) e chamadas por execucao do worker
LLM_TIMEOUT_S=20
LLM_LIMITE_CHAMADAS=20
