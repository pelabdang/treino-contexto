  "info": {
    "title": "treino-contexto API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/atletas/{atleta_id}/atividades/fit": {
      "post": {
        "description": "Envia um FIT (campo multipart `arquivo`). `201` se a atividade é nova; `200` se já existia.",
        "operationId": "enviarAtividadeFit",
        "parameters": [
          {
            "in": "path",
            "name": "atleta_id",
            "required": true,
            "schema": {
              "title": "Atleta Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_enviarAtividadeFit"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadFitOut"
                }
              }
            },
            "description": "Atividade que já existia (atualizada ou ignorada)"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadFitOut"
                }
              }
            },
            "description": "Atividade inserida"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "FIT inválido ou que não é uma atividade, ou extensão diferente de .fit"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Atleta não encontrado"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "Arquivo acima de 10 MB"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Enviar Atividade Fit",
        "tags": [
          "atividades"
        ]
      }
    },
    "/atletas/{atleta_id}/atividades/{atividade_id}": {
      "get": {
        "description": "A atividade com o `clima` (ADR 0007). `indoor`, `sem_posicao`, `pendente` e `falha` dizem por que não há valores.",
        "operationId": "buscarAtividade",
        "parameters": [
          {
            "in": "path",
            "name": "atleta_id",
            "required": true,
            "schema": {
              "title": "Atleta Id",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "atividade_id",
            "required": true,
            "schema": {
              "title": "Atividade Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AtividadeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
